---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { class: className, ...rest } = Astro.props;
---

<a {...rest} class={`bg-red-500 duration-200 flex hover:bg-violet-900 hover:shadow-xl hover:shadow-violet-200 items-center justify-center min-h-[52px] min-w-[120px] rounded-md shadow-lg text-gray-100 transition-all ${className}`}>
  <slot />
</a>
