---
import { Image } from 'astro:assets';

const socials = [
  {
    icon: '/icons/github-square.svg',
    name: 'GitHub',
    url: 'https://github.com/emeraldsanto',
  },
  {
    icon: '/icons/linkedin-square.svg',
    name: 'LinkedIn',
    url: 'https://linkedin.com/in/yanick-belanger-dev',
  },
  {
    icon: '/icons/x-square.svg',
    name: 'X',
    url: 'https://x.com/yanthedev',
  },
];
---

<aside class="flex flex-row items-center justify-between p-5 sm:fixed sm:flex-col sm:h-full sm:w-[70px] static w-[70px] w-full">
  Y
  <div class="flex flex-row sm:flex-col gap-2">
    {socials.map((social) =>
      <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name}>
        <Image alt={`The ${social.name} logo`} height={24} src={social.icon} width={24} />
      </a>
    )}
  </div>
</aside>
