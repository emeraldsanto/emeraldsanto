---
import { getCollection } from 'astro:content';

interface Props {
  active?: string;
}

const { active } = Astro.props;

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order,
);

const linkClasses = (isActive: boolean) =>
  isActive
    ? 'font-mozilla-headline font-medium text-crown-of-thorns no-underline'
    : 'font-mozilla-headline text-maroon-oak underline decoration-1 decoration-maroon-oak underline-offset-3 transition-colors duration-200 hover:text-crown-of-thorns hover:decoration-crown-of-thorns';
---

<nav class='flex flex-wrap gap-x-6 gap-y-3 border-y border-zinc-200 py-3.5 text-sm'>
  <a href='/' class:list={[linkClasses(active === undefined)]}>All</a>
  {
    categories.map((category) => (
      <a href={`/${category.id}`} class:list={[linkClasses(active === category.id)]}>
        {category.data.name}
      </a>
    ))
  }
</nav>
