---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import CategoryNav from '@/components/category-nav.astro';
import Fonts from '@/components/fonts.astro';
import Footer from '@/components/footer.astro';

interface Props {
  description?: string;
  og?: {
    image?: {
      alt: string;
      height: number;
      src: string;
      width: number;
    };
    type?: 'article' | 'website';
  };
  title?: string;
}

const {
  description = 'Concert, event, and sports photography by Yanick Bélanger, based in Montreal.',
  og: { image, type = 'website' } = {},
  title,
} = Astro.props;
const siteName = 'Yanick Bélanger';
const siteUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = image && new URL(image.src, siteUrl);
const isVercel =
  process.env.VERCEL_ENV === 'production' ||
  process.env.VERCEL_ENV === 'preview';
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='description' content={description} />
    <meta name='generator' content={Astro.generator} />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' href='/favicon.ico' sizes='48x48' type='image/x-icon' />
    <title>{[title, siteName].filter(Boolean).join(' — ')}</title>
    <link rel='canonical' href={pageUrl} />
    <meta property='og:type' content={type} />
    <meta property='og:site_name' content={siteName} />
    <meta property='og:title' content={title ?? siteName} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={pageUrl} />
    {image && (
      <>
        <meta property='og:image' content={imageUrl} />
        <meta property='og:image:width' content={image.width.toString()} />
        <meta property='og:image:height' content={image.height.toString()} />
        <meta property='og:image:type' content='image/jpeg' />
        <meta property='og:image:alt' content={image.alt} />
      </>
    )}
    <meta
      name='twitter:card'
      content={image ? 'summary_large_image' : 'summary'}
    />
    <meta name='twitter:site' content='@yanthedev' />
    <meta name='twitter:creator' content='@yanthedev' />
    {image && (
      <>
        <meta name='twitter:image' content={imageUrl} />
        <meta name='twitter:image:alt' content={image.alt} />
      </>
    )}
    <Fonts />
    {isVercel && <Analytics />}
    <ClientRouter />
  </head>
  <body class='bg-zinc-50 font-mozilla-text'>
    <main class='mx-auto max-w-[1100px] px-8 py-16'>
      <CategoryNav active={Astro.url.pathname.split('/').filter(Boolean)[0]} />
      <div class='mt-10'>
        <slot />
      </div>
      <Footer transition:persist />
    </main>
  </body>
</html>
