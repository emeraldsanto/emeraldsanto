---
import { Image as AstroImage } from 'astro:assets';
import type {
  GetStaticPaths,
  InferGetStaticParamsType,
  InferGetStaticPropsType,
} from 'astro';
import Page from '@/layouts/page.astro';
import { listBlobs, listFolders } from '@/utils/blob';

export const getStaticPaths = (async () => {
  const prefix = 'albums/';

  const folders = await listFolders(prefix);

  const matrix = await Promise.all(
    folders.map(async (folder) => {
      const blobs = await listBlobs(folder);

      return blobs.map((blob) => ({
        params: {
          album: folder.replace(prefix, ''),
          image: blob.pathname.replace(folder, ''),
        },
        props: { downloadUrl: blob.downloadUrl },
      }));
    }),
  );

  return matrix.flat();
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { album, image } = Astro.params;
const { downloadUrl } = Astro.props;
---

<Page animated class='flex flex-col' full>
  <AstroImage
    alt={`Image from the ${album} album`}
    class='mx-auto my-auto max-w-full sm:max-w-xl'
    inferSize
    priority
    quality={100}
    src={downloadUrl}
    transition:name={image}
  />
</Page>
