---
import { Image as AstroImage } from 'astro:assets';
import { BLOB_READ_WRITE_TOKEN } from 'astro:env/server';
import { list } from '@vercel/blob';
import type {
  GetStaticPaths,
  InferGetStaticParamsType,
  InferGetStaticPropsType,
} from 'astro';

export const getStaticPaths = (async () => {
  const prefix = 'albums/';

  const { folders } = await list({
    mode: 'folded',
    prefix,
    token: BLOB_READ_WRITE_TOKEN,
  });

  const matrix = await Promise.all(
    folders.map(async (folder) => {
      const { blobs } = await list({
        prefix: folder,
        token: BLOB_READ_WRITE_TOKEN,
      });

      return blobs
        .filter((blob) => blob.pathname !== folder)
        .map((blob) => ({
          params: {
            album: folder.replace(prefix, ''),
            image: blob.pathname.replace(folder, ''),
          },
          props: { downloadUrl: blob.downloadUrl },
        }));
    }),
  );

  return matrix.flat();
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { album, image } = Astro.params;
const { downloadUrl } = Astro.props;
---

<AstroImage
  alt={`Image from the ${album} album`}
  class='rounded-sm mb-4 border border-transparent hover:border-gray-300 transition-all duration-300 ease-in-out hover:shadow-lg'
  inferSize
  priority
  quality={100}
  src={downloadUrl}
/>
