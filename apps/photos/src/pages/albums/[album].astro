---
import { Image } from 'astro:assets';
import { BLOB_READ_WRITE_TOKEN } from 'astro:env/server';
import { list } from '@vercel/blob';
import type {
  GetStaticPaths,
  InferGetStaticParamsType,
  InferGetStaticPropsType,
} from 'astro';
import Page from '@/layouts/page.astro';

export const getStaticPaths = (async () => {
  const prefix = 'albums/';

  const { folders } = await list({
    mode: 'folded',
    prefix,
    token: BLOB_READ_WRITE_TOKEN,
  });

  return folders.map((folder) => ({
    params: { album: folder.replace(prefix, '') },
    props: { key: folder },
  }));
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { album } = Astro.params;
const { key } = Astro.props;

const { blobs } = await list({
  prefix: key,
  token: BLOB_READ_WRITE_TOKEN,
});
---

<Page>
  <h1>{album}</h1>
  <section class='mx-auto my-8 columns-2 md:columns-3'>
    {
      blobs
        .filter((blob) => blob.pathname !== key)
        .sort(() => Math.random() - 0.5)
        .map((blob, index) => (
          <Image
            alt={`Image from the ${album} album`}
            class='rounded-sm mb-4 border border-transparent hover:border-gray-300 transition-all duration-300 ease-in-out hover:shadow-lg'
            inferSize
            priority={index < 9}
            quality={50}
            src={blob.downloadUrl}
          />
        ))
    }
  </section>
</Page>
