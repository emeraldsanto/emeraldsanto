---
import { getCollection } from 'astro:content';
import PressList from '@/components/press-list.astro';
import Gallery from '@/layouts/gallery.astro';

const publications = (await getCollection('publications')).sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime(),
);
---

<Gallery title='Press — Yanick Bélanger' activeCategory='press'>
  <header class='mb-10'>
    <h1 class='font-mozilla-headline text-2xl font-medium text-temptress'>
      Press
    </h1>
    <p class='mt-2 max-w-prose text-sm text-zinc-600'>
      Selected publications and listings featuring my photography.
    </p>
  </header>
  <PressList entries={publications} />
</Gallery>
