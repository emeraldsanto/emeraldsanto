---
import { Image as AstroImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { GetStaticPaths, ImageMetadata, Params } from 'astro';
import Single from '@/layouts/single.astro';

type Props = {
  date: string;
  caption?: string;
  location?: string;
  prevSlug?: string;
  nextSlug?: string;
  image: ImageMetadata;
};

export const getStaticPaths = (async () => {
  const [categories, images] = await Promise.all([
    getCollection('categories'),
    getCollection('images'),
  ]);

  const paths: { params: Params; props: Props }[] = [];

  for (const category of categories) {
    const imagesFromCategory = images.filter(
      (entry) => entry.id.split('/')[0] === category.id,
    );

    for (let i = 0; i < imagesFromCategory.length; i++) {
      const current = imagesFromCategory[i];
      const next = imagesFromCategory[i + 1];
      const prev = imagesFromCategory[i - 1];

      paths.push({
        params: {
          category: category.id,
          image: current.id.split('/').pop() ?? current.id,
        },
        props: {
          caption: current.data.caption,
          date: current.data.date,
          image: current.data.image,
          location: current.data.location,
          nextSlug: next ? next.id.split('/').pop() : undefined,
          prevSlug: prev ? prev.id.split('/').pop() : undefined,
        },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { category, image } = Astro.params;
const {
  caption,
  date,
  image: imageSrc,
  location,
  nextSlug,
  prevSlug,
} = Astro.props;
---

<Single activeCategory={category!}>
  <div class='flex flex-col items-center'>
    <AstroImage
      alt={caption ?? ''}
      class='my-auto w-full max-w-2xl'
      quality={100}
      src={imageSrc}
      transition:name={`${category}-${image}`}
    />
    {caption && (
      <p class='mt-4 text-center text-sm italic text-zinc-500'>{caption}</p>
    )}
    {(date || location) && (
      <p class='mt-2 text-center text-sm text-zinc-500'>
        {date && new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {date && location && ' — '}
        {location}
      </p>
    )}
    <div class='mt-8 flex gap-8 text-sm'>
      {prevSlug && (
        <a href={`/${category}/${prevSlug}`} class='text-maroon-oak underline decoration-1 underline-offset-3 hover:text-crown-of-thorns'>
          ← Previous
        </a>
      )}
      {nextSlug && (
        <a href={`/${category}/${nextSlug}`} class='text-maroon-oak underline decoration-1 underline-offset-3 hover:text-crown-of-thorns'>
          Next →
        </a>
      )}
    </div>
  </div>
</Single>
