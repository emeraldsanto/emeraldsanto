---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PhotoGrid from '@/components/photo-grid.astro';
import Gallery from '@/layouts/gallery.astro';

export const getStaticPaths = (async () => {
  const categories = await getCollection('categories');

  return categories.map((category) => ({ params: { category: category.id } }));
}) satisfies GetStaticPaths;

const { category } = Astro.params;

const images = await getCollection('images');

const imagesFromCategory = images
  .filter((entry) => entry.id.split('/')[0] === category)
  .sort(() => Math.random() - 0.5)
  .map((entry) => ({
    caption: entry.data.caption,
    category: entry.id.split('/')[0],
    image: entry.data.image,
    slug: entry.id.split('/').pop() ?? entry.id,
  }));
---

<Gallery activeCategory={category}>
  <PhotoGrid images={imagesFromCategory} />
</Gallery>
