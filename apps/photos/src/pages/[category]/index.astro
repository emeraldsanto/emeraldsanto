---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PhotoGrid from '@/components/photo-grid.astro';
import Gallery from '@/layouts/gallery.astro';
import { categoryFromId, toGridImage } from '@/utils/images';

export const getStaticPaths = (async () => {
  const [categories, images] = await Promise.all([
    getCollection('categories'),
    getCollection('images'),
  ]);

  // Categories without images (e.g. Press) have dedicated static pages —
  // generating a grid route for them would shadow those pages.
  return categories
    .filter((category) =>
      images.some((entry) => categoryFromId(entry.id) === category.id),
    )
    .map((category) => ({ params: { category: category.id } }));
}) satisfies GetStaticPaths;

const { category } = Astro.params;

const images = await getCollection('images');

const imagesFromCategory = images
  .filter((entry) => categoryFromId(entry.id) === category)
  .sort(() => Math.random() - 0.5)
  .map(toGridImage);
---

<Gallery activeCategory={category}>
  <PhotoGrid images={imagesFromCategory} />
</Gallery>
