---
import { getCollection } from 'astro:content';
import PhotoGrid from '@/components/photo-grid.astro';
import Gallery from '@/layouts/gallery.astro';

const allImages = await getCollection('images');

const featured = allImages
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    image: entry.data.image,
    caption: entry.data.caption,
    slug: entry.id.split('/').pop() ?? entry.id,
    category: entry.id.split('/')[0],
  }));
---

<Gallery>
  <PhotoGrid images={featured} priority={9} />
</Gallery>
